// WidePepper - Loops (chase construct)
// Demonstrates looping and iteration

yarn count = 1;

// Loop 5 times
chase (count <= 5) {
    meow count;
    count = count + 1;
}

// Demonstrate continue (stretch)
yarn i = 0;
chase (i < 10) {
    i = i + 1;
    
    // Skip even numbers
    pounce (i == 2 || i == 4 || i == 6 || i == 8) {
        stretch;
    }
    
    meow i;
}

// Demonstrate break (claw)
yarn attempt = 0;
chase (attempt < 100) {
    attempt = attempt + 1;
    
    pounce (attempt == 5) {
        meow "Found it!";
        claw;
    }
}
